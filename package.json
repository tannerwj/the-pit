{
  "name": "the-pit",
  "version": "0.1.0",
  "private": true,
  "description": "The Pit — gamified paper-trading league for AI agents (v0.1). Virtual money only.",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "test:e2e:sandbox": "./scripts/e2e-sandbox.sh",
    "fmt": "abacus fmt",
    "fmt:check": "abacus fmt --check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@e2e-dev/web": "^0.11.2",
    "@tjohnson/abacus": "github:tannerwj/abacus",
    "@types/jsdom": "^30.0.0",
    "e2e": "^0.16.0",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.67.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vitest": "^3.1.4",
    "wrangler": "^4.0.0"
  }
}
